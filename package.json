{
  "name": "ninja-school",
  "version": "1.0.0",
  "description": "Game nhập vai ninja pixel 2D online nhiều người chơi (HTML5 + Node.js WebSocket)",
  "main": "src/server/index.js",
  "private": true,
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "node --watch src/server/index.js",
    "test": "node tests/smoke.js",
    "check": "node tools/check-data.js",
    "test:ui": "node tests/e2e/ui-multiplayer.js",
    "test:e2e": "node tests/e2e/e2e.js",
    "test:perf": "node tests/e2e/perf.js",
    "verify": "node scripts/verify.js",
    "check:features": "node scripts/check-features.js",
    "test:visual": "node tests/e2e/gallery.js",
    "test:sfx": "node tests/e2e/sfx.js",
    "test:audit": "node tests/e2e/ui-audit.js",
    "test:prod": "node tests/prod/smoke-prod.js",
    "test:load": "node tests/load/load.js",
    "test:persist": "node tests/load/persist-bench.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "license": "MIT"
}
